# Copie este ficheiro para .env e ajuste os valores em produção.
SECRET_KEY=altere-esta-chave-em-producao
FLASK_DEBUG=0

# SQLite (predefinido) ou PostgreSQL:
# DATABASE_URL=sqlite:///instance/nota_saida.db
# DATABASE_URL=postgresql://utilizador:palavra_passe@localhost:5432/nota_saida

# --------------------------------------------------------------------------
# MongoDB (migração em curso — ver docs/Modelo_de_Dados_e_Backend.docx)
#   Todas as 4 variáveis são obrigatórias para a camada de repositórios
#   (app/repositories/*). Lidas por app/services/mongo.py.
# --------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_USER=nota_saida_app
MONGO_PASSWORD=altere-esta-palavra-passe
MONGO_DB_NAME=nota_saida

# --------------------------------------------------------------------------
# Autenticação
#   AUTH_MODE=local -> valida a palavra-passe pelo hash local (desenvolvimento)
#   AUTH_MODE=ldap  -> valida no Active Directory (palavra-passe do computador)
# --------------------------------------------------------------------------
AUTH_MODE=local

# Só necessário quando AUTH_MODE=ldap:
# LDAP_HOST=dc01.standardbank.co.mz
# LDAP_PORT=636
# LDAP_USE_SSL=1
# LDAP_DOMAIN=SBM                       # domínio NetBIOS usado no bind (SBM\A272754)
# LDAP_BASE_DN=DC=standardbank,DC=co,DC=mz

# --------------------------------------------------------------------------
# Pesquisa de destinatários no diretório (campo "Para" da Nota de Saída)
#   simulacao -> lista local de exemplo (predefinido, sem acesso ao AD)
#   ldap      -> pesquisa real no Active Directory (conta de serviço)
# --------------------------------------------------------------------------
DIRECTORY_MODE=simulacao
# Necessário quando DIRECTORY_MODE=ldap (usa LDAP_HOST/PORT/USE_SSL/BASE_DN acima):
# LDAP_BIND_DN=CN=svc-nota-saida,OU=Servicos,DC=standardbank,DC=co,DC=mz
# LDAP_BIND_PASSWORD=troque-isto
# LDAP_DIRECTORY_FILTER=(&(objectClass=user)(objectCategory=person)(|(mail=*{q}*)(displayName=*{q}*)(sAMAccountName={q}*)))

# Formato aceite para o nome de utilizador (nº de colaborador). Ex.: A272754
# USERNAME_REGEX=^[A-Za-z]{1,2}\d{4,8}$

# --------------------------------------------------------------------------
# Signature pad
#   1 -> só a via do pad Wacom grava a assinatura do destinatário/segurança
#        (a via do <canvas> fica bloqueada)
#   0 -> qualquer via serve: <canvas> (rato/touch/caneta) ou pad Wacom (dev)
# --------------------------------------------------------------------------
SIGNATURE_PAD_REQUIRED=0

# --------------------------------------------------------------------------
# Wacom SigCaptX (signature pad Wacom STU)
#   Requer o serviço "Wacom Signature SDK / SigCaptX" instalado em cada PC
#   onde se recolhe a assinatura. O browser liga-se a https://localhost:<porta>.
#   Validar a ligação com Samples/PortCheck.htm da SDK.
#   WACOM_SIGCAPTX_PORT    -> porta do serviço (8000 por omissão)
#   WACOM_SIGCAPTX_LICENCE -> chave de licença Wacom (developer.wacom.com) para
#                             o DynamicCapture; sem ela assina-se só no <canvas>
# --------------------------------------------------------------------------
WACOM_SIGCAPTX_PORT=8000
WACOM_SIGCAPTX_LICENCE=
