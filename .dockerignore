# Controlo de versão
.git
.gitignore
.gitlab-ci.yml

# SDKs de referência (não usados em runtime — os ficheiros necessários já
# estão copiados para app/static/vendor/ e app/static/js/)
1-signature-sdk-js-main/
2-wacom-util-master/
3-sdk-for-signature-sigcaptx-windows-master/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
venv/
.venv/
env/
ENV/

# Ambiente
.env
.env.example
.flaskenv.local

# Dados locais / instância (não devem ir para a imagem)
instance/*.db
instance/*.db-journal
instance/pdfs/*.pdf

# Testes / cobertura / qualidade
.pytest_cache/
.coverage
htmlcov/
.sonar/
target/

# IDE
.idea/
.vscode/
*.swp

# Sistema
.DS_Store
Thumbs.db

# Documentação (não necessária dentro do container)
docs/
CAMINHO_PARA_PRODUCAO.txt

