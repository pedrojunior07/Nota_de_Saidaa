# .env — PRODUÇÃO
# Não versionar (já está no .gitignore). Em UAT/SIT/PROD isto é gerado
# automaticamente pelo pipeline a partir das CI/CD Variables do GitLab
# (Settings → CI/CD → Variables, com o scope certo: uat/sit/prod) — não
# precisas de editar este ficheiro à mão nesses ambientes, só as
# Variables no GitLab. Isto aqui é a referência do que cada uma faz.

SECRET_KEY=<gera uma chave forte e aleatória — nunca reutilizar a de desenvolvimento>
FLASK_DEBUG=0

# --------------------------------------------------------------------------
# Base de dados relacional (SQLite/Postgres) — para o que ainda não foi
# migrado para Mongo (Configuração institucional, Campos adicionais)
# --------------------------------------------------------------------------
DATABASE_URL=postgresql://<utilizador>:<palavra-passe>@<host-postgres-producao>:5432/nota_saida

# --------------------------------------------------------------------------
# MongoDB — <host-mongo-producao> vem da equipa de infra (não é o do teu
# ambiente de testes local)
# --------------------------------------------------------------------------
MONGO_URI=mongodb://<host-mongo-producao>:27017
MONGO_USER=nota_saida_app
MONGO_PASSWORD=<palavra-passe do utilizador de aplicação, não a de root/admin>
MONGO_DB_NAME=nota_saida

USE_MONGO_USERS=1
USE_MONGO_NOTAS=1
USE_MONGO_ENTREGA=1

# --------------------------------------------------------------------------
# Autenticação — Active Directory (é este o bloco que faz o login
# funcionar a sério; valores confirmados a partir da biblioteca interna
# jactive-directory — bind SIMPLE no formato "utilizador@dominio", não
# NTLM "DOMINIO\utilizador")
# --------------------------------------------------------------------------
AUTH_MODE=ldap
# LDAP_HOST=
# (deixa por preencher de propósito — os controladores de domínio são
# descobertos automaticamente via DNS/SRV a partir de LDAP_DOMAIN, tal
# como um PC Windows faz sozinho ao entrar no domínio. O "dc01..." que
# aqui estava antes era um palpite meu, nunca confirmado, e podia estar
# errado. Só preenche isto se precisares de forçar um servidor
# específico.)
LDAP_PORT=636
LDAP_USE_SSL=1
LDAP_DOMAIN=mz.sbicdirectory.com
# LDAP_BASE_DN=
# (fica comentado de propósito — é derivado automaticamente de
# LDAP_DOMAIN: mz.sbicdirectory.com -> DC=mz,DC=sbicdirectory,DC=com)

# --------------------------------------------------------------------------
# Pesquisa de destinatários (campo "Para" da Nota de Saída) — isto é
# SEPARADO do login. Se também quiseres pesquisa real no AD (em vez da
# lista de exemplo), muda para "ldap" e preenche as 3 linhas abaixo;
# senão, deixa em "simulacao".
# --------------------------------------------------------------------------
DIRECTORY_MODE=simulacao
# DIRECTORY_MODE=ldap
# LDAP_BIND_DN=CN=svc-nota-saida,OU=Servicos,DC=mz,DC=sbicdirectory,DC=com
# LDAP_BIND_PASSWORD=<palavra-passe da conta de serviço>
# LDAP_DIRECTORY_FILTER=(&(objectClass=user)(objectCategory=person)(|(mail=*{q}*)(userPrincipalName=*{q}*)(displayName=*{q}*)(sAMAccountName={q}*)))

# Formato do nº de colaborador (login). Ex.: A272754 — só mudar se o
# formato real do banco for diferente disto.
# USERNAME_REGEX=^[A-Za-z]{1,2}\d{4,8}$

SIGNATURE_PAD_REQUIRED=0
